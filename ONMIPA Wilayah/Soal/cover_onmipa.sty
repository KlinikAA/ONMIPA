% Cover ONMIPA Wilayah berdasarkan cover.pdf, dengan teks yang dapat diedit.
% Gunakan \coveronmipasetup{...} setelah \usepackage{cover_onmipa}.
% Font Plus Jakarta Sans SemiBold disertakan; tidak perlu instalasi font.
% Simpan cover_assets di samping dokumen utama. Kompilasi: pdfLaTeX.
\NeedsTeXFormat{LaTeX2e}[2020/10/01]
\ProvidesPackage{cover_onmipa}[2026/10/30 v2.1 Cover Wilayah dengan teks editable]
\RequirePackage{graphicx}
\RequirePackage{tikz}
\RequirePackage{iftex}

% Nilai bawaan mengikuti PDF acuan. Ubah judul/tahun buku melalui
% \coveronmipasetup di ONMIPA Wilayah.tex, setelah \usepackage{cover_onmipa}.
\pgfkeys{
  /coveronmipa/.is family, /coveronmipa,
  judul/.store in=\cn@judul,
  kompetisi/.store in=\cn@kompetisi,
  tingkat/.store in=\cn@tingkat,
  tahun/.store in=\cn@tahun,
  label tahun/.store in=\cn@labeltahun,
  identitas/.store in=\cn@identitas,
  organisasi/.store in=\cn@organisasi,
  ukuran judul/.store in=\cn@ukuranjudul,
  ukuran tahun/.store in=\cn@ukurantahun,
  ukuran identitas/.store in=\cn@ukuranidentitas,
  lebar teks/.store in=\cn@lebarteks,
}
\newcommand{\coveronmipasetup}[1]{\pgfkeys{/coveronmipa/.cd,#1}}
% Kompatibilitas untuk dokumen yang masih memakai nama perintah lama.
\let\covernasionalsetup\coveronmipasetup
\coveronmipasetup{
  judul={Kumpulan Soal},
  kompetisi={ONMIPA-PT},
  tingkat={Tingkat Wilayah},
  tahun={2006-2024},
  label tahun={Tahun},
  identitas={Klinik Aljabar Analisis},
  organisasi={ASCI HIMATIKA ITS 2018-2019},
  ukuran judul=165,
  ukuran tahun=80,
  ukuran identitas=75,
  lebar teks=1360,
}

% Font hanya berlaku di cover; font dan encoding isi buku tetap mengikuti dokumen.
\ifPDFTeX
  \@ifundefined{T@T1}{\input{t1enc.def}}{}
  \pdfmapline{+cnjakarta-sb PlusJakartaSans-SemiBold <cover_assets/fonts/cnjakarta-t1.enc <cover_assets/fonts/cnjakarta-sb.ttf}
  \pdfmapline{+cnjakarta-sbi PlusJakartaSans-SemiBoldItalic <cover_assets/fonts/cnjakarta-t1.enc <cover_assets/fonts/cnjakarta-sbi.ttf}
  \DeclareFontFamily{T1}{cnjakarta}{}
  \DeclareFontShape{T1}{cnjakarta}{m}{n}{<-> cover_assets/fonts/cnjakarta-sb}{}
  \DeclareFontShape{T1}{cnjakarta}{m}{it}{<-> cover_assets/fonts/cnjakarta-sbi}{}
  \newcommand{\cn@selectfont}[2]{%
    \fontencoding{T1}\fontfamily{cnjakarta}\fontseries{m}\fontshape{#2}%
    \fontsize{#1bp}{#1bp}\selectfont
  }
\else
  \RequirePackage{fontspec}
  \newfontfamily\cn@font[
    Path=cover_assets/fonts/,
    UprightFont=cnjakarta-sb.ttf,
    ItalicFont=cnjakarta-sbi.ttf,
    BoldFont=cnjakarta-sb.ttf,
    BoldItalicFont=cnjakarta-sbi.ttf
  ]{cnjakarta-sb.ttf}
  \newcommand{\cn@selectfont}[2]{%
    \cn@font\fontseries{m}\fontshape{#2}\fontsize{#1bp}{#1bp}\selectfont
  }
\fi

% Teks pendek memakai ukuran aslinya. Baris panjang diperkecil proporsional
% agar tidak melewati tepi kanan. Setiap nilai adalah satu baris teks biasa.
\newsavebox{\cn@textbox}
\newcommand{\cn@text}[5]{%
  \node[anchor=base west,inner sep=0pt,outer sep=0pt,text=#3] at (249,#4) {%
    \sbox{\cn@textbox}{\cn@selectfont{#1}{#2}\ignorespaces#5\unskip}%
    \ifdim\wd\cn@textbox>\cn@lebarteks bp
      \resizebox{\cn@lebarteks bp}{!}{\usebox{\cn@textbox}}%
    \else
      \usebox{\cn@textbox}%
    \fi
  };
}

% Warna sRGB dari PDF sumber; tidak dibulatkan ke nama warna umum.
\definecolor{coverWilayahKuning}{rgb}{1,0.933333,0.541176}
\definecolor{coverWilayahKuningMuda}{rgb}{1,0.956863,0.690196}
\definecolor{coverWilayahPutihTeks}{rgb}{0.964604,0.971653,0.999844}
\definecolor{coverWilayahBiruJudul}{rgb}{0.015686,0.184314,0.388235}
\definecolor{coverWilayahEmas}{rgb}{0.749020,0.674510,0.301961}

% Lokasi kedua logo. Font tetap berada di cover_assets/fonts/.
\newcommand{\covernasionalassetpath}{cover_assets/}
\newcommand{\covernasionalsetassetpath}[1]{\renewcommand{\covernasionalassetpath}{#1}}

% Gradasi diagonal asli. Untuk titik (x,y) di panel atas, proyeksi pada
% sumbu gradasi adalah dot((x,y+1710)-(342.964935,740.740112),
% (1715.000122,496.000092)) / (1715.000122^2+496.000092^2).
% Fungsi PDF ini mempertahankan arah, titik awal, dan warna kedua ujung.
\pgfdeclarefunctionalshading{coverWilayahBiru}
  {\pgfpoint{0bp}{0bp}}{\pgfpoint{1760bp}{790bp}}{}{
    969.259888 add 496.000092 mul
    exch 342.964935 sub 1715.000122 mul add
    3187241.509724023 div
    dup 0 lt { pop 0.0 } if
    dup 1 gt { pop 1.0 } if
    dup -0.211765 mul 0.250980 add exch
    dup -0.282353 mul 0.533333 add exch
    -0.286275 mul 0.764706 add
  }

% Seluruh koordinat dalam unit bp PDF sumber, dengan titik (0,0) di kiri bawah.
\newcommand{\covernasionalartwork}{%
  \begin{tikzpicture}[x=1bp,y=1bp]
    \path[use as bounding box] (0,0) rectangle (1760,2500);
    \clip (0,0) rectangle (1760,2500);
    \fill[coverWilayahKuning] (0,0) rectangle (1760,2500);
    \node[anchor=south west,inner sep=0pt,outer sep=0pt] at (0,1710)
      {\pgfuseshading{coverWilayahBiru}};
    \cn@text{\cn@ukuranidentitas}{n}{coverWilayahPutihTeks}{1889}{\cn@identitas}
    \cn@text{\cn@ukuranidentitas}{n}{coverWilayahPutihTeks}{1794}{\cn@organisasi}
    \cn@text{\cn@ukuranjudul}{n}{coverWilayahBiruJudul}{1516}{\cn@judul}
    \cn@text{\cn@ukuranjudul}{n}{coverWilayahBiruJudul}{1308}{\cn@kompetisi}
    \cn@text{\cn@ukuranjudul}{n}{coverWilayahBiruJudul}{1100}{\cn@tingkat}
    \cn@text{\cn@ukurantahun}{it}{coverWilayahEmas}{873}{\cn@labeltahun\space\cn@tahun}
    \fill[coverWilayahKuningMuda] (0,0) rectangle (184,1375);
    \fill[white] (174.498047,0.136963) rectangle (184.498047,2500.136963);
    \fill[white] (0,1375) rectangle (184.328506,1385);
    \node[anchor=south west,inner sep=0pt,outer sep=0pt] at (1360,100)
      {\includegraphics{\covernasionalassetpath logo-himatika.pdf}};
    \node[anchor=south west,inner sep=0pt,outer sep=0pt] at (1090,100)
      {\includegraphics{\covernasionalassetpath logo-its.pdf}};
  \end{tikzpicture}%
}

% Rasio presisi tinggi menghindari pembulatan skala \resizebox pada gambar besar.
\newsavebox{\cn@coverbox}
\ExplSyntaxOn
\cs_new:Npn \cn@ratio #1#2
  { \fp_eval:n { \dim_to_fp:n {#1} / \dim_to_fp:n {#2} } }
\ExplSyntaxOff
\newcommand{\cn@fitpage}{%
  \sbox{\cn@coverbox}{\covernasionalartwork}%
  \scalebox{\cn@ratio{\paperwidth}{\wd\cn@coverbox}}%
    [\cn@ratio{\paperheight}{\ht\cn@coverbox}]{\usebox{\cn@coverbox}}%
}

% Menghasilkan tepat satu halaman cover tanpa header/footer; nomor halaman
% berikutnya berjalan seperti biasa. Tidak mengubah margin atau warna halaman lain.
\newcommand{\makecoveronmipa}{%
  \clearpage
  \thispagestyle{empty}%
  \AddToHookNext{shipout/background}{%
    \put(0,-\paperheight){%
      \cn@fitpage
    }%
  }%
  \null\clearpage
}
\let\makecovernasional\makecoveronmipa

\endinput
